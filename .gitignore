# docs/ is mostly private drafts (articles, paper sources) — excluded by
# default, but the public reference docs that README links to are kept.
# NOTE: must be `docs/*` (not `docs/`) so the negations below can re-include.
docs/*

# Public reference docs. Every file the README links to MUST be listed here,
# or the link 404s on GitHub while working fine locally — which is exactly
# what happened: six of seven README doc links were dead, including
# RESEARCH_LOG.md, the method trail the README cites as its evidence.
!docs/ARCHITECTURE.md
!docs/CODEBASE.md
!docs/OPERATIONS.md
!docs/DEPLOYMENT.md
!docs/PRODUCTION_ENGINEERING.md
!docs/RESEARCH_LOG.md
!docs/OVERREFUSAL_FINDINGS.md
!docs/HALLUCINATION_OPTIMIZATION_LOG.md
!docs/HALLUCINATION_PIPELINE.md
!docs/HALLUCINATION_DETECTION_EXPLAINED.md
!docs/fie_architecture.html
!docs/fie_flowchart.html

# Still private on purpose: paper sources (arxiv_*, *.tex), draft articles,
# and figure notebooks. Those are working material, not reference docs.

# scripts/ holds local retraining experiments — excluded by default, but the
# model-artifact tooling that CI and the Dockerfile depend on is kept.
scripts/*
!scripts/download_models.py
!scripts/model_manifest.json
!scripts/extend_benchmarks.py
!scripts/train_meta_classifier.py
!scripts/nllb_augment.py

# Reproducibility pipeline. These are NOT scratch experiments: they produce the
# numbers quoted in README.md and docs/RESEARCH_LOG.md, and a reader who cannot
# run them cannot check any claim the project makes. They were excluded by the
# blanket scripts/* rule for months, which meant the published findings had no
# runnable provenance — including a commit titled "HarmAug-style generator" that
# contained only a .gitignore edit, because the generator itself was ignored.
#
# NOTE: '#' only starts a comment at the START of a line. A trailing comment
# becomes part of the pattern and silently matches nothing, so each entry below
# is annotated above it rather than beside it.
#
# bootstrap CIs / paired tests — underpins every reported result
!scripts/stats_utils.py
# E8: benchmark leakage removal
!scripts/decontaminate_training.py
# E27: meta-classifier ablation
!scripts/eval_meta_impact.py
# Phase 1: augmentation corpus
!scripts/harmaug_generate.py
# Phase 1: decontaminate + merge
!scripts/harmaug_build_trainset.py
# community feedback -> public dataset
!scripts/export_community_dataset.py
# Phase 1 / E28: train + evaluate the HarmAug reproduction
!scripts/train_pair_harmaug.py
!scripts/eval_harmaug.py
# Phase 2 / E29: BenignAug — the symmetric benign augmentation
!scripts/benignaug_generate.py
!scripts/benignaug_build_trainset.py
# Operator recovery: read your own API key when Google sign-in is down
!scripts/show_api_key.py

# Node / frontend dependencies are restored by `npm install` — never commit.
node_modules/

